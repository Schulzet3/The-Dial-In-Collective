    {
      "signature": "private.dic_roaster_key(value text)",
      "definition": "CREATE OR REPLACE FUNCTION private.dic_roaster_key(value text)\n RETURNS text\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$\n select nullif(regexp_replace(\n  regexp_replace(lower(extensions.unaccent(coalesce(value,''))), '[^a-z0-9]', '', 'g'),\n  '(coffeeroasters|coffeeroaster|coffeeroastery|coffeecompany|coffeeco|roasters|roaster|roastery|coffee)$',\n  ''\n ), '');\n$function$\n",
      "md5": "e553ae6c1cf99c3784f5d14a4f05d355",
      "security_definer": false,
      "settings": [
        "search_path=\"\""
      ],
      "anon_execute": false,
      "authenticated_execute": false,
      "service_execute": false,
      "complete_chars": 388,
      "verdict": "LEGACY ACTIVE: suffix-aware roaster matching called by canonical helper; not removable merely by name."
    },
    {
      "signature": "private.dic_source_key(value text)",
      "definition": "CREATE OR REPLACE FUNCTION private.dic_source_key(value text)\n RETURNS text\n LANGUAGE plpgsql\n STABLE\n SET search_path TO ''\nAS $function$\ndeclare raw text; path text; params text; kept text:=''; part text;\nbegin\n raw:=btrim(coalesce(value,''));\n if raw !~* '^https?://[^/?#[:space:]]+' or length(raw)>4000 then return null;end if;\n raw:=split_part(raw,'#',1);\n raw:=regexp_replace(raw,'^https?://(www\\.)?','','i');\n path:=split_part(raw,'?',1);\n if path='' then return null;end if;\n params:=case when strpos(raw,'?')>0 then substring(raw from strpos(raw,'?')+1) else '' end;\n if params<>'' then\n  foreach part in array string_to_array(params,'&') loop\n   if split_part(lower(part),'=',1)!~'^utm_' and\n     lower(split_part(part,'=',1)) not in ('gclid','fbclid','msclkid','srsltid')\n       and part<>'' then\n    kept:=concat_ws('&',nullif(kept,''),part);\n   end if;\n  end loop;\n end if;\n return lower(rtrim(path,'/'))||case when kept<>'' then '?'||kept else '' end;\nend $function$\n",
      "md5": "07e0ef286246fdae29b9151018296f79",
      "security_definer": false,
      "settings": [
        "search_path=\"\""
      ],
      "anon_execute": false,
      "authenticated_execute": false,
      "service_execute": false,
      "complete_chars": 981,
      "verdict": "LEGACY ACTIVE: source URL evidence normalization used by two matching/promotion routines; not a transport SSRF sanitizer."
    },
    {
      "signature": "private.dic_verified_roaster_page_proof(roaster_name text)",
      "definition": "CREATE OR REPLACE FUNCTION private.dic_verified_roaster_page_proof(roaster_name text)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare host_count integer; official_host text; canonical_name text;\nbegin\n with official_pages as (\n  select distinct c.roaster as source_roaster,\n   lower(regexp_replace(split_part(s.source_url,'/',3),'^www\\.','','i')) as source_host\n  from public.coffees c join public.coffee_sources s on s.coffee_id=c.id\n  where c.verification_state='verified' and c.merged_into_id is null\n   and s.source_kind='roaster_page' and s.checked_at>=now()-interval '120 days'\n   and s.source_url ~* '^https://(www\\.)?[a-z0-9-]+(\\.[a-z0-9-]+)+(/|$)'\n   and private.dic_canonical_roaster_key(c.roaster)=private.dic_canonical_roaster_key(roaster_name)\n )\n select count(distinct source_host),min(source_host),min(source_roaster)\n into host_count,official_host,canonical_name from official_pages;\n -- Conflicting verified product source domains must be reviewed, not guessed.\n if host_count>1 then return null; end if;\n if host_count=1 and official_host is not null then\n  if exists(select 1 from private.dic_official_source_attestations a\n    where a.canonical_key=private.dic_canonical_roaster_key(roaster_name)\n      and a.official_domain<>official_host) then return null; end if;\n  return jsonb_build_object('official_domain',official_host,'canonical_name',canonical_name);\n end if;\n -- Preserve prior independently verified official BRAND evidence for the\n -- original source worker bootstrap. This NEVER gates a URL preview.\n select a.canonical_name,a.official_domain into canonical_name,official_host\n from private.dic_official_source_attestations a\n where a.canonical_key=private.dic_canonical_roaster_key(roaster_name);\n if official_host is null then return null; end if;\n return jsonb_build_object('official_domain',official_host,'canonical_name',canonical_name);\nend $function$\n",
      "md5": "7ce32408a61728294ad667a9c985f5da",
      "security_definer": true,
