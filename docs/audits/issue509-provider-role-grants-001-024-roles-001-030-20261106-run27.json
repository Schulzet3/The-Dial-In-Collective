  "read_only_sql_complete": "WITH grants AS (SELECT row_number() OVER (ORDER BY r.rolname,m.rolname,g.rolname) ordinal,r.rolname granted_role,m.rolname member_role,g.rolname grantor_role,a.admin_option,a.inherit_option,a.set_option,md5(concat_ws('|',r.rolname,m.rolname,g.rolname,a.admin_option::text,a.inherit_option::text,a.set_option::text)) row_md5 FROM pg_auth_members a JOIN pg_roles r ON r.oid=a.roleid JOIN pg_roles m ON m.oid=a.member JOIN pg_roles g ON g.oid=a.grantor),roles AS (SELECT row_number() OVER(ORDER BY rolname) ordinal,rolname,rolsuper,rolinherit,rolcreaterole,rolcreatedb,rolcanlogin,rolreplication,rolbypassrls,rolconnlimit,rolvaliduntil IS NULL no_expiry,md5(concat_ws('|',rolname,rolsuper::text,rolinherit::text,rolcreaterole::text,rolcreatedb::text,rolcanlogin::text,rolreplication::text,rolbypassrls::text,rolconnlimit::text)) row_md5 FROM pg_roles),schema_rights AS (SELECT nspname schema_name,has_schema_privilege('anon',oid,'USAGE') anon_usage,has_schema_privilege('authenticated',oid,'USAGE') authenticated_usage,has_schema_privilege('service_role',oid,'USAGE') service_usage FROM pg_namespace WHERE nspname NOT LIKE 'pg_temp%' AND nspname NOT LIKE 'pg_toast%'),rels AS (SELECT n.nspname schema_name,c.relkind,c.relrowsecurity,has_schema_privilege('anon',n.oid,'USAGE') anon_schema_usage,has_schema_privilege('authenticated',n.oid,'USAGE') auth_schema_usage,has_table_privilege('anon',c.oid,'SELECT') anon_select,has_table_privilege('authenticated',c.oid,'SELECT') auth_select FROM pg_class c JOIN pg_namespace n ON c.relnamespace=n.oid WHERE c.relkind IN ('r','p','v','m','f') AND n.nspname IN ('auth','extensions','graphql','graphql_public','private','public','realtime','storage','vault','pgbouncer','supabase_migrations')), rel_summaries AS (SELECT schema_name,count(*) total_relations,count(*) FILTER(WHERE anon_select AND anon_schema_usage) anon_selectable,count(*) FILTER(WHERE auth_select AND auth_schema_usage) authenticated_selectable,count(*) FILTER(WHERE NOT relrowsecurity AND relkind IN ('r','p') AND anon_select AND anon_schema_usage) unguarded_anon_tables,count(*) FILTER(WHERE NOT relrowsecurity AND relkind IN ('r','p') AND auth_select AND auth_schema_usage) unguarded_auth_tables FROM rels GROUP BY 1),risk_rel AS (SELECT n.nspname schema_name,c.relname,c.relkind,c.relrowsecurity,c.relowner::regrole::text owner,has_table_privilege('anon',c.oid,'SELECT') anon_select,has_table_privilege('authenticated',c.oid,'SELECT') auth_select,has_table_privilege('anon',c.oid,'INSERT') anon_insert,has_table_privilege('anon',c.oid,'UPDATE') anon_update,has_table_privilege('anon',c.oid,'DELETE') anon_delete FROM pg_class c JOIN pg_namespace n ON c.relnamespace=n.oid WHERE n.nspname IN ('auth','private','public','realtime','storage','vault','graphql','graphql_public') AND c.relkind IN ('r','p') AND NOT c.relrowsecurity AND (has_table_privilege('anon',c.oid,'SELECT') OR has_table_privilege('authenticated',c.oid,'SELECT'))),risk_role AS (SELECT rolname role_name,pg_has_role(rolname,'service_role','USAGE') usable_service,pg_has_role(rolname,'service_role','SET') can_set_service,pg_has_role(rolname,'pg_monitor','USAGE') usable_monitor,pg_has_role(rolname,'pg_read_all_data','USAGE') usable_read_all,pg_has_role(rolname,'supabase_privileged_role','USAGE') usable_privileged FROM pg_roles WHERE rolname IN ('anon','authenticated','authenticator','service_role','supabase_realtime_admin','supabase_storage_admin','postgres','supabase_read_only_user')) SELECT jsonb_build_object('grants',(SELECT jsonb_agg(to_jsonb(grants) ORDER BY ordinal) FROM grants),'roles',(SELECT jsonb_agg(to_jsonb(roles) ORDER BY ordinal) FROM roles),'schema_privileges',(SELECT jsonb_agg(to_jsonb(schema_rights) ORDER BY schema_name) FROM schema_rights),'relation_summary',(SELECT jsonb_agg(to_jsonb(rel_summaries) ORDER BY schema_name) FROM rel_summaries),'unguarded',(SELECT coalesce(jsonb_agg(to_jsonb(risk_rel) ORDER BY schema_name,relname),'[]'::jsonb) FROM risk_rel),'role_paths',(SELECT jsonb_agg(to_jsonb(risk_role) ORDER BY role_name) FROM risk_role),'membership_manifest_md5',(SELECT md5(string_agg(roleid::text||':'||member::text||':'||grantor::text||':'||admin_option::text||':'||inherit_option::text||':'||set_option::text,'|' ORDER BY roleid,member,grantor)) FROM pg_auth_members)) AS dataset",
  "method": "Complete non-sensitive role attribute and pg_auth_members rows, stable OID manifest and per-row MD5, direct semantic review; no SQL/DML/credentials/identities exported.",
