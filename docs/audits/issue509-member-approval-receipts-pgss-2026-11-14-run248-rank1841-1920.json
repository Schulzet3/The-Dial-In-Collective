    {
      "signature": "private.dic_on_community_coffee_verification()",
      "definition": "CREATE OR REPLACE FUNCTION private.dic_on_community_coffee_verification()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare target uuid; lib record;\nbegin\n if row(new.verification_state,new.merged_into_id)\n    is not distinct from row(old.verification_state,old.merged_into_id)\n then return new;end if;\n update public.community_shots\n   set quality_state=case when new.verification_state='verified'\n                       then 'pending_quality' else 'held' end,\n       updated_at=clock_timestamp()\n   where coffee_id=new.id and quality_state<>'withdrawn';\n if new.verification_state='verified' then\n  for lib in select owner_id,id from public.library_entries where coffee_id=new.id loop\n   perform private.dic_backfill_library_contributions(lib.owner_id,lib.id,new.id);\n  end loop;\n  for target in select id from public.community_shots\n                 where coffee_id=new.id and quality_state='pending_quality'\n  loop perform private.dic_review_community_shot(target); end loop;\n end if;\n return new;\nend $function$\n",
      "md5": "cefee7b991e40185eadbacde89def3aa",
      "security_definer": true,
      "settings": [
        "search_path=\"\""
      ],
      "anon_execute": false,
      "authenticated_execute": false,
      "service_execute": false,
      "verdict": "Verification trigger transitions quality states and re-review; no direct client EXECUTE; downstream effects not run."
    },
    {
      "signature": "private.dic_review_pending_community(p_limit integer)",
      "definition": "CREATE OR REPLACE FUNCTION private.dic_review_pending_community(p_limit integer DEFAULT 100)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare target uuid; reviewed integer:=0; eligible_count integer:=0;\n        held_count integer:=0; result text;\nbegin\n if p_limit is null or p_limit not between 1 and 500 then\n  raise exception using errcode='22023',message='Community review limit must be 1–500.';\n end if;\n for target in select id from public.community_shots\n                where quality_state='pending_quality'\n                order by updated_at,id limit p_limit\n loop\n  result:=private.dic_review_community_shot(target);\n  reviewed:=reviewed+1;\n  if result='eligible' then eligible_count:=eligible_count+1;end if;\n  if result='held' then held_count:=held_count+1;end if;\n end loop;\n return jsonb_build_object('reviewed',reviewed,'eligible',eligible_count,'held',held_count);\nend $function$\n",
      "md5": "ff876442da558f60f7eccb36bd6dbe62",
      "security_definer": true,
      "settings": [
        "search_path=\"\""
      ],
      "anon_execute": false,
      "authenticated_execute": false,
      "service_execute": true,
      "verdict": "Service-only, bounded 1-500, ordered pending quality review; no reproduced error."
    },
    {
      "signature": "public.dic_confirm_community_outlier(p_shot_id uuid, p_expected_revision bigint)",
      "definition": "CREATE OR REPLACE FUNCTION public.dic_confirm_community_outlier(p_shot_id uuid, p_expected_revision bigint)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare u uuid; target uuid; s public.shots; c public.community_shots;\n        reason_code text; disposition text;\nbegin\n u:=private.require_member();\n select * into s from public.shots where id=p_shot_id and owner_id=u;\n if s.id is null or s.revision<>p_expected_revision then\n  return jsonb_build_object('ok',false,'reason','not_found_or_conflict');\n end if;\n select cs.* into c from public.community_shots cs\n  join private.contribution_links l on l.community_shot_id=cs.id\n  where l.shot_id=s.id for update of cs;\n if c.id is null or c.quality_state<>'held' then\n  return jsonb_build_object('ok',false,'reason','no_outlier_confirmation_pending');\n end if;\n select reason into reason_code from private.community_quality_checks\n  where community_shot_id=c.id;\n if reason_code is distinct from 'extreme_outlier' then\n  return jsonb_build_object('ok',false,'reason','no_outlier_confirmation_pending');\n end if;\n update private.community_quality_checks\n   set confirmed_fingerprint=private.dic_community_fingerprint(c),\n       reviewed_at=clock_timestamp()\n   where community_shot_id=c.id;\n disposition:=private.dic_review_community_shot(c.id);\n return jsonb_build_object('ok',disposition='eligible','state',disposition);\nend $function$\n",
      "md5": "0657114255a0375b7f3fc502f780aa54",
      "security_definer": true,
      "settings": [
        "search_path=\"\""
      ],
      "anon_execute": false,
      "authenticated_execute": true,
      "service_execute": true,
      "verdict": "Requires own shot, revision, held contribution, reason and row lock before confirmation; no hosted signed-in behavior claimed."
    },
    {
      "signature": "public.dic_member_approval_claim(p_channel text, p_limit integer)",
      "definition": "CREATE OR REPLACE FUNCTION public.dic_member_approval_claim(p_channel text, p_limit integer DEFAULT 20)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare batches jsonb;\nbegin\n if p_channel not in ('email','push') or p_channel is null or\n    p_limit is null or p_limit not between 1 and 20 then\n  raise exception using errcode='22023',message='Invalid delivery channel/limit';\n end if;\n with chosen as (\n  select d.event_id,d.channel\n  from private.dic_member_approval_deliveries d\n  join private.beta_members m on m.owner_id=d.member_id\n  join auth.users u on u.id=d.member_id\n  where d.channel=p_channel and m.signup_review_state='approved'\n   and m.enabled and m.admitted_at is not null\n   and u.email_confirmed_at is not null\n   and ((d.state='pending' and d.next_attempt_at<=now())\n    or (d.state='sending' and d.lease_until < now()))\n  order by d.event_id limit p_limit for update of d skip locked\n ), claimed as (\n  update private.dic_member_approval_deliveries d\n  set state='sending',attempt_count=d.attempt_count+1,\n      claim_token=gen_random_uuid(),lease_until=now()+interval '2 minutes'\n  from chosen c where d.event_id=c.event_id and d.channel=c.channel\n  returning d.event_id,d.member_id,d.claim_token\n )\n select coalesce(jsonb_agg(jsonb_build_object(\n   'eventId',c.event_id,'claimToken',c.claim_token,\n   'email',case when p_channel='email' then left(u.email,254) else null end,\n   'endpoints',case when p_channel='push' then (\n    select coalesce(jsonb_agg(jsonb_build_object('hash',s.endpoint_hash,'endpoint',s.endpoint)),'[]'::jsonb)\n    from public.dic_member_approval_push_subscriptions s\n    where s.owner_id=c.member_id and s.expires_at>now()\n      and s.last_sent_event_id<c.event_id\n   ) else '[]'::jsonb end\n  ) order by c.event_id),'[]'::jsonb) into batches\n from claimed c join auth.users u on u.id=c.member_id;\n return batches;\nend $function$\n",
      "md5": "b0d1e8d2622852b6b930def5c8a171d9",
      "security_definer": true,
      "settings": [
        "search_path=\"\""
      ],
      "anon_execute": false,
      "authenticated_execute": false,
      "service_execute": true,
      "verdict": "Service-only lease claim, checks channel/limit NULLs, admitted and verified status and SKIP LOCKED; SQL source only, no user records read."
    },
    {
      "signature": "public.dic_member_approval_finish(p_event_id bigint, p_channel text, p_claim_token uuid, p_outcome text)",
      "definition": "CREATE OR REPLACE FUNCTION public.dic_member_approval_finish(p_event_id bigint, p_channel text, p_claim_token uuid, p_outcome text)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n if p_channel not in ('email','push') or p_outcome not in ('sent','skipped','retry')\n   or p_claim_token is null or p_event_id is null then\n  raise exception using errcode='22023',message='Invalid delivery receipt';\n end if;\n update private.dic_member_approval_deliveries d\n set state=case when p_outcome='retry' then 'pending' else p_outcome end,\n     claim_token=null,lease_until=null,\n     completed_at=case when p_outcome='retry' then null else now() end,\n     next_attempt_at=case when p_outcome='retry' then\n       now()+least(60,power(2,least(d.attempt_count,5))::integer)*interval '1 minute'\n       else d.next_attempt_at end\n where d.event_id=p_event_id and d.channel=p_channel and\n   d.state='sending' and d.claim_token=p_claim_token;\n return found;\nend $function$\n",
      "md5": "e92ba8e17ab274bcab1a564475d16f28",
