    "functions": [
      {
        "acl": null,
        "md5": "ccefb34283c346cc88e224d075bd5312",
        "chars": 791,
        "owner": "supabase_storage_admin",
        "signature": "storage.allow_any_operation(text[])",
        "definition": "CREATE OR REPLACE FUNCTION storage.allow_any_operation(expected_operations text[])\n RETURNS boolean\n LANGUAGE sql\n STABLE\nAS $function$\n  WITH current_operation AS (\n    SELECT storage.operation() AS raw_operation\n  ),\n  normalized AS (\n    SELECT CASE\n      WHEN raw_operation LIKE 'storage.%' THEN substr(raw_operation, 9)\n      ELSE raw_operation\n    END AS current_operation\n    FROM current_operation\n  )\n  SELECT EXISTS (\n    SELECT 1\n    FROM normalized n\n    CROSS JOIN LATERAL unnest(expected_operations) AS expected_operation\n    WHERE expected_operation IS NOT NULL\n      AND expected_operation <> ''\n      AND n.current_operation = CASE\n        WHEN expected_operation LIKE 'storage.%' THEN substr(expected_operation, 9)\n        ELSE expected_operation\n      END\n  );\n$function$\n",
        "security_definer": false,
        "review_verdict": "Storage operation allowlist normalizes optional prefixes and rejects empty/null expected operations."
      },
      {
        "acl": null,
        "md5": "e2f7d55adc027df69ec4b42c6c08f50f",
        "chars": 773,
        "owner": "supabase_storage_admin",
        "signature": "storage.allow_only_operation(text)",
        "definition": "CREATE OR REPLACE FUNCTION storage.allow_only_operation(expected_operation text)\n RETURNS boolean\n LANGUAGE sql\n STABLE\nAS $function$\n  WITH current_operation AS (\n    SELECT storage.operation() AS raw_operation\n  ),\n  normalized AS (\n    SELECT\n      CASE\n        WHEN raw_operation LIKE 'storage.%' THEN substr(raw_operation, 9)\n        ELSE raw_operation\n      END AS current_operation,\n      CASE\n        WHEN expected_operation LIKE 'storage.%' THEN substr(expected_operation, 9)\n        ELSE expected_operation\n      END AS requested_operation\n    FROM current_operation\n  )\n  SELECT CASE\n    WHEN requested_operation IS NULL OR requested_operation = '' THEN FALSE\n    ELSE COALESCE(current_operation = requested_operation, FALSE)\n  END\n  FROM normalized;\n$function$\n",
        "security_definer": false,
        "review_verdict": "Exact normalized single operation; null/empty expected operation explicitly returns false."
      },
      {
        "acl": null,
        "md5": "73733c9319875273d5937b05d68a7930",
        "chars": 433,
        "owner": "supabase_storage_admin",
        "signature": "storage.can_insert_object(text,text,uuid,jsonb)",
        "definition": "CREATE OR REPLACE FUNCTION storage.can_insert_object(bucketid text, name text, owner uuid, metadata jsonb)\n RETURNS void\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  INSERT INTO \"storage\".\"objects\" (\"bucket_id\", \"name\", \"owner\", \"metadata\") VALUES (bucketid, name, owner, metadata);\n  -- hack to rollback the successful insert\n  RAISE sqlstate 'PT200' using\n  message = 'ROLLBACK',\n  detail = 'rollback successful insert';\nEND\n$function$\n",
        "security_definer": false,
        "review_verdict": "Intentionally probes INSERT policy then raises PT200 to roll back; do not invoke as production mutation or label dead."
      },
      {
        "acl": "{supabase_storage_admin=X/supabase_storage_admin}",
        "md5": "fce9d03398ec222c77feec887c25c384",
        "chars": 1016,
        "owner": "supabase_storage_admin",
        "signature": "storage.protect_active_lifecycle_states()",
        "definition": "CREATE OR REPLACE FUNCTION storage.protect_active_lifecycle_states()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog'\nAS $function$\nBEGIN\n    IF EXISTS (\n        SELECT 1 FROM storage.bucket_lifecycle_states\n        WHERE bucket_id = OLD.id\n          AND NOT (\n              continuation IS NULL\n              OR (continuation @> '{\"continuationVersion\": 1}' AND continuation #> '{batch,inFlight}' IS NULL)\n          )\n    ) THEN\n        RAISE EXCEPTION 'update or delete on table \"buckets\" violates foreign key constraint \"bucket_lifecycle_states_bucket_id_fkey\" on table \"bucket_lifecycle_states\"'\n            USING ERRCODE = 'foreign_key_violation',\n                  DETAIL = format('Key (id)=(%s) is still referenced from table \"bucket_lifecycle_states\".', OLD.id),\n                  SCHEMA = 'storage',\n                  TABLE = 'bucket_lifecycle_states',\n                  CONSTRAINT = 'bucket_lifecycle_states_bucket_id_fkey';\n    END IF;\n    RETURN OLD;\nEND;\n$function$\n",
        "security_definer": true,
        "review_verdict": "Owner-only EXECUTE, pinned pg_catalog, prevents deletion with lifecycle in-flight work."
      },
      {
        "acl": null,
        "md5": "7c31ae406e2f6281ead4009fff69fc68",
        "chars": 1858,
        "owner": "supabase_storage_admin",
        "signature": "storage.protect_bucket_control_columns()",
        "definition": "CREATE OR REPLACE FUNCTION storage.protect_bucket_control_columns()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog'\nAS $function$\nDECLARE\n  configuration_changed boolean;\nBEGIN\n  IF TG_OP = 'INSERT' THEN\n    IF NEW.lifecycle_configuration IS NOT NULL\n       OR NEW.lifecycle_configuration_generation IS NOT NULL THEN\n      IF NOT pg_has_role(current_user, TG_ARGV[0], 'MEMBER') THEN\n        RAISE EXCEPTION 'only members of the configured storage service role may insert lifecycle policy state'\n          USING ERRCODE = '42501',\n                HINT = format(\n                  'Insert with both lifecycle columns NULL and configure lifecycle through the Storage API afterward, or insert as a member of %I.',\n                  TG_ARGV[0]\n                );\n      END IF;\n    END IF;\n\n    RETURN NEW;\n  END IF;\n\n  configuration_changed =\n    OLD.lifecycle_configuration IS DISTINCT FROM NEW.lifecycle_configuration\n    OR OLD.lifecycle_configuration_generation IS DISTINCT FROM NEW.lifecycle_configuration_generation;\n\n  IF NOT configuration_changed THEN\n    RETURN NEW;\n  END IF;\n\n  IF NEW.type IS DISTINCT FROM 'STANDARD' THEN\n    RAISE EXCEPTION 'bucket versioning and lifecycle controls require a Standard bucket'\n      USING ERRCODE = '0A000';\n  END IF;\n\n  IF NEW.lifecycle_configuration IS NULL\n     AND NEW.lifecycle_configuration_generation IS NULL THEN\n    RETURN NEW;\n  END IF;\n\n  IF NEW.lifecycle_configuration IS NULL\n     OR NEW.lifecycle_configuration_generation IS NULL\n     OR OLD.lifecycle_configuration IS NOT DISTINCT FROM NEW.lifecycle_configuration\n     OR OLD.lifecycle_configuration_generation IS NOT DISTINCT FROM NEW.lifecycle_configuration_generation THEN\n    RAISE EXCEPTION 'a changed lifecycle policy requires a new non-null generation'\n      USING ERRCODE = '22023';\n  END IF;\n\n  RETURN NEW;\nEND;\n$function$\n",
        "security_definer": false,
        "review_verdict": "Insert lifecycle privilege checked; update requires generation consistency, with separate AFTER UPDATE service role enforcement trigger."
      },
      {
        "acl": null,
        "md5": "4371ae544fb1ef704f9c5d42265ac324",
        "chars": 535,
        "owner": "supabase_storage_admin",
        "signature": "storage.protect_delete()",
        "definition": "CREATE OR REPLACE FUNCTION storage.protect_delete()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n    -- Check if storage.allow_delete_query is set to 'true'\n    IF COALESCE(current_setting('storage.allow_delete_query', true), 'false') != 'true' THEN\n        RAISE EXCEPTION 'Direct deletion from storage tables is not allowed. Use the Storage API instead.'\n            USING HINT = 'This prevents accidental data loss from orphaned objects.',\n                  ERRCODE = '42501';\n    END IF;\n    RETURN NULL;\nEND;\n$function$\n",
        "security_definer": false,
        "review_verdict": "BEFORE DELETE statement trigger blocks SQL deletes absent explicit storage.allow_delete_query setting."
      },
      {
        "acl": "{supabase_storage_admin=X/supabase_storage_admin,service_role=X/supabase_storage_admin}",
        "md5": "271a57ecfb24df02a5d9100c2a801323",
        "chars": 2912,
        "owner": "supabase_storage_admin",
        "signature": "storage.reconcile_lifecycle_state(text,boolean)",
        "definition": "CREATE OR REPLACE FUNCTION storage.reconcile_lifecycle_state(target_bucket_id text, policy_changed boolean)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog'\nAS $function$\nDECLARE\n    bucket storage.buckets%ROWTYPE;\n    active boolean;\n    idle boolean;\n    state_generation uuid;\nBEGIN\n    SELECT * INTO bucket FROM storage.buckets WHERE id = target_bucket_id FOR NO KEY UPDATE;\n    IF NOT FOUND THEN\n        RETURN;\n    END IF;\n\n    SELECT continuation IS NULL OR (\n               continuation @> '{\"continuationVersion\": 1}'\n               AND continuation #> '{batch,inFlight}' IS NULL\n           ), generation\n    INTO idle, state_generation\n    FROM storage.bucket_lifecycle_states\n    WHERE bucket_id = target_bucket_id\n    FOR UPDATE;\n\n    IF bucket.lifecycle_configuration IS NULL THEN\n        DELETE FROM storage.bucket_lifecycle_states\n        WHERE bucket_id = target_bucket_id\n          AND idle IS TRUE;\n\n        UPDATE storage.bucket_lifecycle_states\n        SET next_run_at = clock_timestamp(), updated_at = clock_timestamp()\n        WHERE bucket_id = target_bucket_id\n          AND idle IS NOT TRUE;\n        RETURN;\n    END IF;\n\n    active := bucket.versioning_status <> 'DISABLED'\n        AND bucket.lifecycle_configuration @> '{\"rules\":[{\"status\":\"Enabled\"}]}'::jsonb;\n\n    -- The state row records the generation it was reconciled with so callers need not detect\n    -- policy changes. Rows without a recorded generation keep their work.\n    policy_changed := policy_changed OR (\n        state_generation IS NOT NULL AND state_generation <> bucket.lifecycle_configuration_generation\n    );\n\n    INSERT INTO storage.bucket_lifecycle_states AS state (bucket_id, generation, next_run_at)\n    VALUES (bucket.id, bucket.lifecycle_configuration_generation, CASE WHEN active THEN clock_timestamp() END)\n    ON CONFLICT (bucket_id) DO UPDATE\n    SET next_run_at = CASE\n            WHEN policy_changed THEN\n                CASE WHEN active OR idle IS NOT TRUE THEN clock_timestamp() END\n            ELSE EXCLUDED.next_run_at\n        END,\n        generation = EXCLUDED.generation,\n        claim_id = CASE WHEN policy_changed AND idle IS TRUE\n                        THEN NULL ELSE state.claim_id END,\n        claim_until = CASE WHEN policy_changed AND idle IS TRUE\n                           THEN NULL ELSE state.claim_until END,\n        continuation = CASE WHEN policy_changed AND idle IS TRUE\n                            THEN NULL ELSE state.continuation END,\n        failure_count = CASE WHEN policy_changed AND idle IS TRUE\n                             THEN 0 ELSE state.failure_count END,\n        last_error = CASE WHEN policy_changed AND idle IS TRUE\n                          THEN NULL ELSE state.last_error END,\n        updated_at = clock_timestamp()\n    WHERE policy_changed OR (state.next_run_at IS NULL AND EXCLUDED.next_run_at IS NOT NULL);\nEND;\n$function$\n",
        "security_definer": true,
        "review_verdict": "Owner/service EXECUTE only, pinned pg_catalog; reconciles pending in-flight lifecycle state."
      }
    ],
