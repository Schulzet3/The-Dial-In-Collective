  "query": "WITH ranked AS (SELECT row_number() OVER (ORDER BY s.total_exec_time DESC,s.queryid) AS ordinal,s.queryid::text AS queryid,r.rolname AS role_name,s.calls,round(s.mean_exec_time::numeric,3) AS mean_ms,round(s.total_exec_time::numeric,1) AS total_ms,round(s.max_exec_time::numeric,1) AS max_ms,s.shared_blks_hit,s.shared_blks_read,s.temp_blks_written,s.temp_blks_read,s.rows,CASE WHEN ltrim(s.query) ILIKE 'WITH%' THEN 'WITH' WHEN ltrim(s.query) ILIKE 'SELECT%' THEN 'SELECT' WHEN ltrim(s.query) ILIKE 'INSERT%' THEN 'INSERT' WHEN ltrim(s.query) ILIKE 'UPDATE%' THEN 'UPDATE' WHEN ltrim(s.query) ILIKE 'DELETE%' THEN 'DELETE' ELSE 'OTHER' END AS kind,lower((regexp_match(s.query,'dic_[a-z0-9_]+','i'))[1]) AS dic_identifier FROM pg_stat_statements s LEFT JOIN pg_roles r ON r.oid=s.userid WHERE s.calls>0), selected AS (SELECT * FROM ranked WHERE ordinal BETWEEN 481 AND 560) SELECT jsonb_build_object('observed_at',now(),'stats_reset',(SELECT stats_reset FROM pg_stat_statements_info),'total_active_fingerprints',(SELECT count(*) FROM pg_stat_statements WHERE calls>0),'selected',(SELECT jsonb_agg(to_jsonb(selected) ORDER BY ordinal) FROM selected)) AS evidence",
