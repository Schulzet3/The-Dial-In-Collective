  "server_version": "17.11",
  "scope": "New per-record safe live cumulative PostgreSQL I/O/WAL/checkpointer/SLRU/activity/anonymous temp-usage semantic inspection; no query strings, identities, member data or logs",
  "query_sources": {
    "io": "SELECT t.*,md5(row_to_json(t)::text) record_md5 FROM (SELECT backend_type::text,object::text,context::text,reads,read_time,writes,write_time,hits,evictions,reuses,fsyncs,fsync_time,stats_reset::text FROM pg_stat_io)t ORDER BY backend_type,object,context",
    "slru": "SELECT t.*,md5(row_to_json(t)::text) record_md5 FROM (SELECT name,blks_zeroed,blks_hit,blks_read,blks_written,blks_exists,flushes,truncates,stats_reset::text FROM pg_stat_slru)t ORDER BY name",
    "wal": "SELECT wal_records,wal_fpi,wal_bytes,wal_buffers_full,wal_write,wal_sync,wal_write_time,wal_sync_time,stats_reset::text FROM pg_stat_wal",
    "bg": "SELECT * FROM pg_stat_bgwriter",
    "cp": "SELECT * FROM pg_stat_checkpointer",
    "db": "SELECT numbackends,xact_commit,xact_rollback,blks_read,blks_hit,temp_files,temp_bytes,deadlocks,conflicts,session_time,active_time,idle_in_transaction_time,stats_reset::text FROM pg_stat_database WHERE datname=current_database()",
    "wait": "SELECT backend_type::text,state::text,wait_event_type::text,count(*)::int sessions FROM pg_stat_activity GROUP BY 1,2,3 ORDER BY 1,2,3",
    "locks": "SELECT locktype::text,mode::text,granted,count(*)::int lock_count FROM pg_locks GROUP BY 1,2,3 ORDER BY 1,2,3",
    "repl": "SELECT slot_type::text,active,count(*)::int slot_count FROM pg_replication_slots GROUP BY slot_type,active",
    "guc": "SELECT name,setting,unit,source FROM pg_settings WHERE name IN ('track_io_timing','track_wal_io_timing','wal_buffers','checkpoint_timeout','max_wal_size','synchronous_commit') ORDER BY name",
    "ps": "SELECT count(*)::int signatures,coalesce(sum(calls),0) calls,coalesce(sum(temp_blks_written),0) temp_written,coalesce(sum(temp_blks_read),0) temp_read,count(*) FILTER(WHERE temp_blks_written>0)::int temp_producers,count(*) FILTER(WHERE calls>=10 AND mean_exec_time>100)::int slow_signatures FROM extensions.pg_stat_statements",
    "ranks": "SELECT row_number() OVER (ORDER BY temp_blks_written DESC,calls DESC)::int anon_rank,calls,round(mean_exec_time::numeric,1) mean_ms,round(max_exec_time::numeric,1) max_ms,temp_blks_written,temp_blks_read FROM extensions.pg_stat_statements WHERE temp_blks_written>0 ORDER BY temp_blks_written DESC,calls DESC LIMIT 11",
    "psinfo": "SELECT dealloc,stats_reset::text FROM extensions.pg_stat_statements_info",
    "stamp": "SELECT current_timestamp::text captured_utc,current_setting('server_version') pg_version"
  },
