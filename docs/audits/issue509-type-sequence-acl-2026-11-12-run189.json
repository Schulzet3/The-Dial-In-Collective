  "method": "Complete live current enum/domain/range type definitions and 8 sequence parameters/ACL/dependencies. Individual Postgres md5 over row_to_json record and complete literal records saved. Read-only catalog only; no personal/Auth/member rows or credentials.",
  "sql_query": "WITH ty AS (SELECT n.nspname schema,t.typname name,t.typtype kind,format_type(t.oid,NULL) full_type,pg_get_userbyid(t.typowner) owner,t.typacl::text acl,CASE WHEN t.typtype='e' THEN 'ENUM ('||(SELECT string_agg(quote_literal(enumlabel),', ' ORDER BY enumsortorder) FROM pg_enum WHERE enumtypid=t.oid)||')' ELSE format_type(t.typbasetype,t.typtypmod) END definition,(SELECT count(*) FROM pg_attribute a JOIN pg_class c ON c.oid=a.attrelid JOIN pg_namespace nn ON nn.oid=c.relnamespace WHERE a.atttypid=t.oid AND a.attnum>0 AND NOT a.attisdropped AND nn.nspname IN ('public','private')) app_columns FROM pg_type t JOIN pg_namespace n ON n.oid=t.typnamespace WHERE n.nspname IN ('auth','private','public','realtime','storage') AND t.typtype IN ('e','d','r','m')), seq AS (SELECT n.nspname schema,c.relname name,pg_get_userbyid(c.relowner) owner,c.relacl::text acl,format_type(s.seqtypid,NULL) data_type,s.seqstart,s.seqincrement,s.seqmin,s.seqmax,s.seqcache,s.seqcycle,COALESCE(d.refobjid::regclass::text,'none') owned_by_table,COALESCE(a.attname,'none') owned_by_column,d.deptype dependency_type,pg_get_expr(ad.adbin,ad.adrelid) column_default FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace JOIN pg_sequence s ON s.seqrelid=c.oid LEFT JOIN pg_depend d ON d.objid=c.oid AND d.classid='pg_class'::regclass AND d.refclassid='pg_class'::regclass AND d.deptype IN ('a','i') LEFT JOIN pg_attribute a ON a.attrelid=d.refobjid AND a.attnum=d.refobjsubid LEFT JOIN pg_attrdef ad ON ad.adrelid=d.refobjid AND ad.adnum=d.refobjsubid WHERE c.relkind='S' AND n.nspname IN ('auth','private','public','realtime','storage')), p AS (SELECT n.nspname schema,c.relname name,r.role,has_sequence_privilege(r.role,c.oid,'USAGE') AS can_use,has_sequence_privilege(r.role,c.oid,'SELECT') AS can_select,has_sequence_privilege(r.role,c.oid,'UPDATE') AS can_update FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace CROSS JOIN (SELECT unnest(ARRAY['anon','authenticated','service_role']) role)r WHERE c.relkind='S' AND n.nspname IN ('auth','private','public','realtime','storage')), tb AS (SELECT n.nspname schema,c.relname name,r.role,c.relacl::text acl,c.relrowsecurity,has_table_privilege(r.role,c.oid,'SELECT') can_select,has_table_privilege(r.role,c.oid,'INSERT') can_insert,has_table_privilege(r.role,c.oid,'UPDATE') can_update FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace CROSS JOIN (SELECT unnest(ARRAY['anon','authenticated','service_role']) role) r WHERE (n.nspname='realtime' AND c.relname='subscription') OR (n.nspname='private' AND c.relname IN ('admin_access_events','admin_content_edits','dic_admin_delete_receipts','dic_coffee_audit','dic_signup_review_events','shot_audit'))), acl AS (SELECT n.nspname schema,pg_get_userbyid(d.defaclrole) grantor,d.defaclobjtype kind,d.defaclacl::text grants FROM pg_default_acl d LEFT JOIN pg_namespace n ON n.oid=d.defaclnamespace WHERE n.nspname IN ('auth','private','public','realtime','storage') OR d.defaclnamespace=0) SELECT jsonb_build_object('types',(SELECT jsonb_agg(to_jsonb(ty)||jsonb_build_object('md5',md5(row_to_json(ty)::text)) ORDER BY schema,name) FROM ty),'sequences',(SELECT jsonb_agg(to_jsonb(seq)||jsonb_build_object('md5',md5(row_to_json(seq)::text)) ORDER BY schema,name) FROM seq),'seq_privileges',(SELECT jsonb_agg(to_jsonb(p) ORDER BY schema,name,role) FROM p),'table_privileges',(SELECT jsonb_agg(to_jsonb(tb) ORDER BY schema,name,role) FROM tb),'default_acl',(SELECT jsonb_agg(to_jsonb(acl) ORDER BY schema,grantor,kind) FROM acl)) AS audit",
