  "source_sql": {
    "fingerprints": "SELECT row_number() over(order by s.temp_blks_written DESC,s.queryid)::int AS ordinal,s.queryid::text AS fingerprint,r.rolname AS db_role,s.calls,s.rows,s.temp_blks_written,s.temp_blks_read,round(s.total_exec_time::numeric,2) AS total_exec_ms,round(s.mean_exec_time::numeric,2) AS mean_exec_ms,round(s.max_exec_time::numeric,2) AS max_exec_ms,(s.query ~* '(pg_catalog|information_schema|pg_stat_|pg_class|pg_proc|pg_attribute|pg_amop|pg_amproc|pg_type|pg_index|pg_constraint)') AS catalog_observability_shape,(s.query ~* '(public[.]|private[.]|auth[.]|storage[.])') AS schema_qualified FROM pg_stat_statements s JOIN pg_roles r ON r.oid=s.userid WHERE s.temp_blks_written>0 ORDER BY s.temp_blks_written DESC,s.queryid LIMIT 100",
    "roles": "SELECT r.rolname AS db_role,count(*)::int AS fingerprints,sum(s.calls)::bigint AS calls,count(*) FILTER (WHERE s.temp_blks_written>0)::int AS temp_fingerprints,coalesce(sum(s.temp_blks_written),0)::bigint AS temp_written_blocks,coalesce(sum(s.temp_blks_read),0)::bigint AS temp_read_blocks,round(sum(s.total_exec_time)::numeric,2) AS total_exec_ms FROM pg_stat_statements s JOIN pg_roles r ON r.oid=s.userid GROUP BY 1 ORDER BY temp_written_blocks DESC,db_role",
    "io": "SELECT backend_type,object,context,op_bytes,sum(reads)::bigint AS reads,sum(writes)::bigint AS writes,sum(writebacks)::bigint AS writebacks,sum(extends)::bigint AS extends,sum(hits)::bigint AS hits,sum(evictions)::bigint AS evictions,sum(fsyncs)::bigint AS fsyncs,max(stats_reset) AS stats_reset FROM pg_stat_io GROUP BY 1,2,3,4 ORDER BY writes DESC,reads DESC,backend_type LIMIT 80",
    "summary": "SELECT clock_timestamp()::text AS observed_utc,d.stats_reset::text AS db_stats_reset,d.temp_bytes,d.temp_files,d.deadlocks,(SELECT stats_reset::text FROM pg_stat_statements_info) AS stmt_stats_reset,(SELECT count(*) FROM pg_stat_statements) AS fingerprints,(SELECT count(*) FROM pg_stat_statements WHERE temp_blks_written>0) AS temp_writers,(SELECT sum(temp_blks_written) FROM pg_stat_statements) AS temp_written_blocks,current_setting('block_size')::int AS block_bytes,(SELECT setting FROM pg_settings WHERE name='track_io_timing') AS track_io_timing,(SELECT setting FROM pg_settings WHERE name='pg_stat_statements.track') AS pgss_track FROM pg_stat_database d WHERE d.datname=current_database()"
  },
