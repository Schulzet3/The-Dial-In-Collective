    "empty": "SELECT 'pg_seclabel' AS name,count(*) AS records FROM pg_seclabel UNION ALL SELECT 'pg_shseclabel',count(*) FROM pg_shseclabel UNION ALL SELECT 'pg_transform',count(*) FROM pg_transform UNION ALL SELECT 'pg_statistic_ext',count(*) FROM pg_statistic_ext UNION ALL SELECT 'pg_foreign_data_wrapper',count(*) FROM pg_foreign_data_wrapper UNION ALL SELECT 'pg_foreign_server',count(*) FROM pg_foreign_server UNION ALL SELECT 'pg_user_mapping',count(*) FROM pg_user_mapping UNION ALL SELECT 'pg_subscription',count(*) FROM pg_subscription UNION ALL SELECT 'pg_replication_origin',count(*) FROM pg_replication_origin UNION ALL SELECT 'pg_prepared_xacts',count(*) FROM pg_prepared_xacts UNION ALL SELECT 'pg_inherits',count(*) FROM pg_inherits ORDER BY name",
    "top": "SELECT queryid::text AS id,calls,round(total_exec_time::numeric,2) AS total_ms,round(mean_exec_time::numeric,3) AS mean_ms,round(max_exec_time::numeric,3) AS max_ms,rows,shared_blks_hit,shared_blks_read,temp_blks_written FROM pg_stat_statements WHERE queryid IS NOT NULL AND calls>=10 ORDER BY total_exec_time DESC,queryid LIMIT 30",
    "roles": "SELECT coalesce(r.rolname,'unknown_role') AS role,count(*) AS fingerprints,sum(s.calls) AS calls,round(sum(s.total_exec_time)::numeric,1) AS total_ms,sum(s.temp_blks_written) AS temp_blocks,count(*) FILTER (WHERE s.mean_exec_time>200 AND s.calls>=10) AS slow_mean FROM pg_stat_statements s LEFT JOIN pg_roles r ON r.oid=s.userid GROUP BY 1 ORDER BY sum(s.temp_blks_written) DESC,1",
    "config": "SELECT name,setting,source,pending_restart FROM pg_settings WHERE name IN ('track_functions','track_activities','track_counts','track_io_timing','compute_query_id','log_min_duration_statement','log_lock_waits','deadlock_timeout','shared_preload_libraries','pg_stat_statements.track','pg_stat_statements.track_utility') ORDER BY name",
    "db": "SELECT clock_timestamp() AS at,numbackends,xact_commit,xact_rollback,deadlocks,temp_files,temp_bytes,blk_read_time,blk_write_time,stats_reset FROM pg_stat_database WHERE datname=current_database()",
    "fn": "SELECT count(*) AS function_stat_rows FROM pg_stat_user_functions",
    "locks": "SELECT count(*) FILTER (WHERE NOT granted) AS waiting_locks,count(*) FILTER (WHERE granted) AS granted_locks FROM pg_locks"
