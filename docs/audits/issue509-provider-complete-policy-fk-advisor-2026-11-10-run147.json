        "full_sql": "CREATE OR REPLACE FUNCTION private.is_member()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select exists(select 1 from private.beta_members m where m.owner_id=(select auth.uid()) and m.enabled);\n$function$\n",
